# Set to false to force local-search-only mode.
REDIS_ENABLED=true

# Remote Redis server address.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Search-result cache lifetime in seconds.
REDIS_CACHE_TTL=300

# Short timeouts keep Redis failures from blocking local search.
REDIS_CONNECT_TIMEOUT_MS=300
REDIS_SOCKET_TIMEOUT_MS=500
